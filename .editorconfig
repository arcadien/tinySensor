# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cpp,h,hpp}]
max_line_length = 80

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{kicad_pcb,kicad_sch,kicad_pro,kicad_prl,kicad_mod,sch,lib,net,cir,xml}]
# KiCad files are tool-generated: leave them as is
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
